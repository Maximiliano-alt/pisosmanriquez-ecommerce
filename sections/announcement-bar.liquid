{%- comment -%}
  Primer elemento del body en TODAS las paginas.
  Marca html.pm-js para que las animaciones de entrada solo se activen si hay JS.
  Sin esta linea, si el JS falla la web queda invisible.
{%- endcomment -%}
<script>document.documentElement.classList.add('pm-js');</script>
{{ 'section-promo-bar.css' | asset_url | stylesheet_tag }}
{{ 'pm-redesign.css' | asset_url | stylesheet_tag }}

<div class="pm-topbar" role="region" aria-label="Información de contacto y showroom">
  <div class="page-width pm-topbar__inner">
    {%- if section.settings.showroom != blank -%}
      <span class="pm-topbar__item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span><strong>{{ section.settings.showroom | escape }}</strong>{% if section.settings.address != blank %}: {{ section.settings.address | escape }}{% endif %}</span>
      </span>
    {%- endif -%}
    {%- if section.settings.schedule != blank -%}
      <span class="pm-topbar__sep" aria-hidden="true">|</span>
      <span class="pm-topbar__item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span>{{ section.settings.schedule | escape }}</span>
      </span>
    {%- endif -%}
    {%- if section.settings.email != blank -%}
      <span class="pm-topbar__sep" aria-hidden="true">|</span>
      <a class="pm-topbar__item pm-topbar__email" href="mailto:{{ section.settings.email }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span>{{ section.settings.email }}</span>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "announcement-bar-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "showroom", "label": "Showroom (nombre)", "default": "Showroom Las Condes" },
    { "type": "text", "id": "address", "label": "Dirección", "default": "Manquehue Sur 1581, Las Condes" },
    { "type": "text", "id": "schedule", "label": "Horario", "default": "Lun-Vie 08:00 a 19:00" },
    { "type": "text", "id": "email", "label": "Email", "default": "contacto@pisosmanriquez.cl" }
  ],
  "presets": [ { "name": "t:sections.announcement-bar.name" } ]
}
{% endschema %}
