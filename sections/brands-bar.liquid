{{ 'pm-redesign.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pm-redesign.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  PISOS MANRIQUEZ - Marquee de marcas. El track se duplica por JS.
{%- endcomment -%}

{%- assign s = section.settings -%}

{%- if section.blocks.size > 0 -%}
  <section class="pm-marquee">
    {%- if s.title != blank -%}
      <p class="pm-marquee__title">{{ s.title | escape }}</p>
    {%- endif -%}

    <div class="pm-marquee__mask">
      <div class="pm-marquee__track" data-pm-marquee>
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}
            <a class="pm-marquee__item" href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="pm-marquee__item" {{ block.shopify_attributes }}>
          {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- elsif block.settings.asset_name != blank -%}
              <img src="{{ block.settings.asset_name | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" height="42">
            {%- else -%}
              <span>{{ block.settings.name | default: 'Marca' | escape }}</span>
            {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "PM · Marcas",
  "class": "pm-marquee-section",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Distribuidores oficiales de" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "asset_name", "label": "Logo desde assets/" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM · Marcas",
      "blocks": [
        { "type": "brand", "settings": { "name": "Carpenter" } },
        { "type": "brand", "settings": { "name": "BS Chile" } },
        { "type": "brand", "settings": { "name": "Winter" } },
        { "type": "brand", "settings": { "name": "Quick-Step" } },
        { "type": "brand", "settings": { "name": "Getnet" } }
      ]
    }
  ]
}
{% endschema %}
