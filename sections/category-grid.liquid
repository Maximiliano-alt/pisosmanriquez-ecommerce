{{ 'section-category-grid.css' | asset_url | stylesheet_tag }}

<div class="category-grid page-width color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  {%- if section.settings.title != blank -%}
    <h2 class="category-grid__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="category-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          if block.settings.collection != blank
            assign link_url   = block.settings.collection.url
            assign link_title = block.settings.label | default: block.settings.collection.title
            assign coll_img   = block.settings.collection.image
          else
            assign link_url   = '#'
            assign link_title = block.settings.label | default: 'Categoría'
            assign coll_img   = nil
          endif
          assign picker_img = block.settings.image
          assign asset_file = block.settings.asset_name
          assign display_img = coll_img | default: picker_img
        -%}
        <li
          class="category-grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}style="animation-delay: {{ forloop.index | times: 100 }}ms"{% endif %}
        >
          <a href="{{ link_url }}" class="category-grid__link" aria-label="{{ link_title | escape }}">
            <div class="category-grid__image-wrapper">
              {%- if display_img != blank -%}
                {{
                  display_img
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 20vw, (min-width: 600px) 33vw, 50vw',
                    widths: '280, 380, 480, 600',
                    alt: 'Pisos Manríquez — ' | append: link_title
                }}
                <div class="category-grid__overlay">
                  <p class="category-grid__name">{{ link_title | escape }}</p>
                </div>
              {%- elsif asset_file != blank -%}
                <img
                  src="{{ asset_file | asset_url }}"
                  alt="{{ 'Pisos Manríquez — ' | append: link_title | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                  class="category-grid__asset-img"
                >
                <div class="category-grid__overlay">
                  <p class="category-grid__name">{{ link_title | escape }}</p>
                </div>
              {%- else -%}
                <div class="category-grid__placeholder">
                  <p class="category-grid__placeholder-name">{{ link_title | escape }}</p>
                </div>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Grilla de categorías",
  "class": "section-category-grid",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Somos distribuidores de todas las marcas top en el mercado"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de colores",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Categoría",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto personalizado",
          "info": "Si está vacío, se usa el nombre de la colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen override (Shopify CDN)",
          "info": "Se usa si la colección no tiene imagen asignada"
        },
        {
          "type": "text",
          "id": "asset_name",
          "label": "Imagen desde assets/ (último fallback)",
          "info": "Ej: pm-cat-pisos-flotantes.webp",
          "placeholder": "pm-cat-pisos-flotantes.webp"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grilla de categorías",
      "blocks": [
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" },
        { "type": "category_card" }
      ]
    }
  ]
}
{% endschema %}
