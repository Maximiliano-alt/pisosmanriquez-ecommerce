{{ 'section-pm-hero.css' | asset_url | stylesheet_tag }}

<section class="pm-hero{% unless section.settings.image %} pm-hero--no-image{% endunless %}">
  {%- if section.settings.image != blank -%}
    <div class="pm-hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'pm-hero__img',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.headline | escape
      }}
    </div>
  {%- endif -%}

  <div class="pm-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>

  {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
    <div class="pm-hero__badge" aria-hidden="true"><span>{{ section.settings.badge_text }}</span></div>
  {%- endif -%}

  <div class="pm-hero__content">
    {%- if section.settings.headline != blank -%}
      <h2 class="pm-hero__title">{{ section.settings.headline | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheadline != blank -%}
      <p class="pm-hero__sub">{{ section.settings.subheadline | escape }}</p>
    {%- endif -%}
    <div class="pm-hero__ctas">
      {%- if section.settings.cta1_text != blank -%}
        <a class="pm-hero__btn pm-hero__btn--primary" href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}">{{ section.settings.cta1_text | escape }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_text != blank -%}
        <a class="pm-hero__btn pm-hero__btn--ghost" href="{{ section.settings.cta2_link | default: '#' }}">{{ section.settings.cta2_text | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Pisos Manríquez",
  "class": "pm-hero-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo", "info": "Ambiente de piso de madera en interior moderno. Si queda vacío se usa un degradado." },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Oscurecer imagen (overlay)", "default": 45 },
    { "type": "text", "id": "headline", "label": "Título", "default": "45 años vistiendo los mejores espacios" },
    { "type": "text", "id": "subheadline", "label": "Subtítulo", "default": "Pisos flotantes · Vinílicos · Cerámicos · Alfombras · Papel mural · Pasto sintético" },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "cta1_text", "label": "Botón 1 (naranja)", "default": "Ver catálogo" },
    { "type": "url", "id": "cta1_link", "label": "Enlace botón 1" },
    { "type": "text", "id": "cta2_text", "label": "Botón 2 (outline)", "default": "Cotiza tu proyecto" },
    { "type": "url", "id": "cta2_link", "label": "Enlace botón 2" },
    { "type": "header", "content": "Badge" },
    { "type": "checkbox", "id": "show_badge", "label": "Mostrar badge 45 años", "default": true },
    { "type": "text", "id": "badge_text", "label": "Texto del badge", "default": "45 AÑOS" }
  ],
  "presets": [ { "name": "Hero Pisos Manríquez" } ]
}
{% endschema %}
