{{ 'section-pm-hero.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
<div class="pm-hero"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed | default: 6 }}"
  aria-label="{{ section.settings.accessibility_info | default: 'Hero slideshow' | escape }}"
>
  <div class="pm-hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign text_align = block.settings.text_align | default: 'center'
        assign box_align  = block.settings.box_align  | default: 'middle-center'
      -%}
      <div
        class="pm-hero__slide{% if forloop.first %} is-active{% endif %}"
        {{ block.shopify_attributes }}
        role="group"
        aria-label="{{ 'sections.slideshow.slide_count' | t: current: forloop.index, total: section.blocks.size }}"
      >
        {%- if block.settings.asset_name != blank -%}
          <img
            src="{{ block.settings.asset_name | asset_url }}"
            alt="{{ block.settings.heading | default: 'Pisos Manríquez' | escape }}"
            class="pm-hero__img"
            {% if forloop.first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
            width="1600"
            height="700"
          >
        {%- else -%}
          <div class="pm-hero__placeholder"></div>
        {%- endif -%}

        <div class="pm-hero__overlay" style="--overlay-opacity: {{ block.settings.image_overlay_opacity | default: 40 }}"></div>

        {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
          <div class="pm-hero__content pm-hero__content--{{ box_align }} pm-hero__content--align-{{ text_align }}">
            {%- if block.settings.heading != blank -%}
              <h2 class="pm-hero__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <p class="pm-hero__subheading">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                href="{{ block.settings.button_link | default: '/' }}"
                class="pm-hero__btn{% if block.settings.button_style_secondary %} pm-hero__btn--secondary{% endif %}"
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="pm-hero__arrow pm-hero__arrow--prev" aria-label="Slide anterior">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="pm-hero__arrow pm-hero__arrow--next" aria-label="Siguiente slide">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <div class="pm-hero__dots" role="tablist" aria-label="Slides">
      {%- for block in section.blocks -%}
        <button
          class="pm-hero__dot{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="Slide {{ forloop.index }}"
          data-index="{{ forloop.index0 }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{%- endif -%}

<script>
(function() {
  const hero = document.querySelector('.pm-hero');
  if (!hero) return;

  const track   = hero.querySelector('.pm-hero__track');
  const slides  = [...hero.querySelectorAll('.pm-hero__slide')];
  const dots    = [...hero.querySelectorAll('.pm-hero__dot')];
  const prev    = hero.querySelector('.pm-hero__arrow--prev');
  const next    = hero.querySelector('.pm-hero__arrow--next');
  const speed   = parseInt(hero.dataset.speed || '6', 10) * 1000;
  const autoplay = hero.dataset.autoplay !== 'false';

  let current = 0;
  let timer;

  function goTo(idx) {
    slides[current].classList.remove('is-active');
    if (dots[current]) dots[current].classList.remove('is-active');
    current = (idx + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    if (dots[current]) { dots[current].classList.add('is-active'); dots[current].setAttribute('aria-selected', 'true'); }
    dots.forEach((d, i) => { if (i !== current) d.setAttribute('aria-selected', 'false'); });
  }

  function startTimer() {
    if (!autoplay || slides.length < 2) return;
    timer = setInterval(() => goTo(current + 1), speed);
  }

  function resetTimer() { clearInterval(timer); startTimer(); }

  if (prev) prev.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
  if (next) next.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
  dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); resetTimer(); }));

  hero.addEventListener('mouseenter', () => clearInterval(timer));
  hero.addEventListener('mouseleave', () => startTimer());

  // Touch/swipe
  let touchStartX = 0;
  hero.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  hero.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) { goTo(dx < 0 ? current + 1 : current - 1); resetTimer(); }
  }, { passive: true });

  startTimer();
})();
</script>

{% schema %}
{
  "name": "Hero Pisos Manríquez",
  "class": "section-pm-hero",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Rotar automáticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "label": "Segundos por slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Descripción accesible",
      "default": "Slideshow Pisos Manríquez"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "asset_name",
          "label": "Nombre de archivo en assets/",
          "info": "Ej: pm-slider-53.png — debe estar en la carpeta assets del tema",
          "placeholder": "pm-slider-53.png"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtítulo"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Enlace del botón"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Botón estilo secundario (outline)",
          "default": false
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Alineación de texto",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "box_align",
          "label": "Posición del contenido",
          "options": [
            { "value": "top-left", "label": "Arriba izquierda" },
            { "value": "top-center", "label": "Arriba centro" },
            { "value": "top-right", "label": "Arriba derecha" },
            { "value": "middle-left", "label": "Centro izquierda" },
            { "value": "middle-center", "label": "Centro" },
            { "value": "middle-right", "label": "Centro derecha" },
            { "value": "bottom-left", "label": "Abajo izquierda" },
            { "value": "bottom-center", "label": "Abajo centro" },
            { "value": "bottom-right", "label": "Abajo derecha" }
          ],
          "default": "middle-center"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "label": "Opacidad del overlay (%)",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 35
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Pisos Manríquez",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "asset_name": "pm-slider-53.png",
            "heading": "45 años de experiencia",
            "subheading": "Distribuidores de pisos y revestimientos — Santiago, Chile",
            "button_label": "Ver catálogo",
            "button_link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
