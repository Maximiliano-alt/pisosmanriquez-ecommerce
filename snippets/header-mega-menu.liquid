{% comment %} PM mega menu — panel hover por categoría (sin details, para que abra al pasar el mouse) {% endcomment %}
<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- assign pm_col = link.object -%}
      <li class="pm-nav__item">
        <a id="HeaderMenu-{{ link.handle }}" href="{{ link.url }}" class="header__menu-item list-menu__item link focus-inset">
          <span{% if link.current or link.child_active %} class="header__active-menu-item"{% endif %}>{{ link.title | escape }}</span>
        </a>
        <div class="pm-mega__content gradient" tabindex="-1">
          <div class="page-width pm-mega__inner">
            <div class="pm-mega__media">
              {%- if pm_col != blank and pm_col.image != blank -%}
                <img src="{{ pm_col.image | image_url: width: 640 }}" alt="{{ pm_col.title | escape }}" loading="lazy" width="640" height="420">
              {%- else -%}
                <div class="pm-mega__fallback"><span>{{ link.title | escape }}</span></div>
              {%- endif -%}
            </div>
            <div class="pm-mega__body">
              <h3 class="pm-mega__title">{{ link.title | escape }}</h3>
              {%- if pm_col != blank and pm_col.description != blank -%}
                <p class="pm-mega__desc">{{ pm_col.description | strip_html | truncatewords: 28 }}</p>
              {%- else -%}
                <p class="pm-mega__desc">Descubre nuestra selección de {{ link.title | downcase }}. Calidad y asesoría con 45 años de experiencia.</p>
              {%- endif -%}
              <a href="{{ link.url }}" class="pm-mega__cta">Ver {{ link.title | downcase }}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </div>
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</nav>
